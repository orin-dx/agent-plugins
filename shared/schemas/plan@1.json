{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan@1",
  "title": "Plan",
  "description": "A sequenced implementation plan. Every task is bite-sized, TDD-first, with exact code and commit message.",
  "type": "object",
  "required": ["goal", "architecture", "tech_stack", "tasks"],
  "additionalProperties": false,
  "properties": {
    "goal": {
      "type": "string",
      "description": "One sentence: what this plan produces"
    },
    "architecture": {
      "type": "string",
      "description": "2-3 sentences on the implementation approach"
    },
    "tech_stack": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Key libraries, frameworks, or runtimes involved"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "files", "steps", "commit_message"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "files": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "create": { "type": "array", "items": { "type": "string" } },
              "modify": { "type": "array", "items": { "type": "string" } },
              "test": { "type": "array", "items": { "type": "string" } }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Ordered steps. Each step is one action. Code steps include exact code. Test steps include exact command and expected output."
          },
          "commit_message": {
            "type": "string",
            "description": "Conventional commit message for this task"
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs of tasks that must complete before this one"
          }
        }
      }
    },
    "linked_spec": {
      "type": "string",
      "description": "ID of the spec@1 this plan implements"
    },
    "reasoning": {
      "type": "string",
      "description": "Agent scratchpad — not consumed downstream"
    }
  }
}
