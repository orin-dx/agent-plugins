{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-review@1",
  "title": "Implementation Review",
  "description": "Pre-gate review of an implementation batch, including related defect instances and structural signals.",
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "approved" } }
      },
      "then": {
        "properties": {
          "issues": {
            "not": {
              "contains": {
                "required": ["severity"],
                "properties": { "severity": { "const": "must_fix" } }
              }
            }
          },
          "defect_families": {
            "items": {
              "properties": {
                "instances": {
                  "not": {
                    "contains": {
                      "required": ["status"],
                      "properties": { "status": { "const": "unresolved" } }
                    }
                  }
                },
                "disposition": { "not": { "const": "architecture_escalation" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "changes_requested" } }
      },
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "required": ["severity"],
              "properties": { "severity": { "const": "must_fix" } }
            }
          },
          "defect_families": {
            "not": {
              "contains": {
                "required": ["disposition"],
                "properties": { "disposition": { "const": "architecture_escalation" } }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": { "status": { "const": "needs_architecture" } }
      },
      "then": {
        "properties": {
          "defect_families": {
            "contains": {
              "required": ["disposition"],
              "properties": { "disposition": { "const": "architecture_escalation" } }
            }
          }
        }
      }
    }
  ],
  "required": ["id", "workspace", "batch_id", "language", "status", "sibling_search", "issues", "defect_families", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable review identifier."
    },
    "workspace": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace containing the reviewed implementation."
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "description": "Implementation batch covered by this review."
    },
    "language": {
      "enum": ["rust", "typescript", "javascript"],
      "description": "Primary implementation language used to select architecture evidence."
    },
    "linked_spec": {
      "type": "string",
      "minLength": 1
    },
    "linked_plan": {
      "type": "string",
      "minLength": 1
    },
    "linked_requirement": {
      "type": "string",
      "minLength": 1
    },
    "spec_file_path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["approved", "changes_requested", "needs_architecture"],
      "description": "approved when no required work remains; changes_requested for scoped repairs; needs_architecture when a structural correction must be designed first."
    },
    "sibling_search": {
      "type": "object",
      "required": ["scope", "syntactic", "semantic"],
      "additionalProperties": false,
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "syntactic": {
          "type": "object",
          "required": ["method", "evidence", "matches"],
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "matches": { "type": "integer", "minimum": 0 }
          }
        },
        "semantic": {
          "type": "object",
          "required": ["method", "evidence", "matches"],
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "matches": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "description", "severity"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["must_fix", "suggestion"] },
          "family_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defect_families": {
      "type": "array",
      "description": "Groups a changed defect with syntactic or semantic siblings that share a root cause.",
      "items": {
        "type": "object",
        "allOf": [
          {
            "if": {
              "required": ["disposition"],
              "properties": {
                "disposition": { "const": "explicit_deferral" }
              }
            },
            "then": {
              "required": ["deferral_reason"],
              "properties": {
                "instances": {
                  "contains": {
                    "required": ["status"],
                    "properties": { "status": { "const": "deferred" } }
                  }
                }
              }
            },
            "else": {
              "not": { "required": ["deferral_reason"] },
              "properties": {
                "instances": {
                  "items": {
                    "properties": { "status": { "not": { "const": "deferred" } } }
                  }
                }
              }
            }
          }
        ],
        "required": ["id", "summary", "shared_root_cause", "instances", "semantic_model", "architecture", "disposition"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "shared_root_cause": { "type": "string", "minLength": 1 },
          "instances": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["file", "line", "relationship", "status", "evidence"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 },
                "relationship": {
                  "enum": ["original", "syntactic_sibling", "semantic_sibling"],
                  "description": "How this instance belongs to the family."
                },
                "status": { "enum": ["fixed", "unresolved", "deferred"] },
                "evidence": { "type": "string", "minLength": 1 }
              }
            }
          },
          "semantic_model": {
            "type": "object",
            "required": ["assessment", "description", "evidence"],
            "additionalProperties": false,
            "properties": {
              "assessment": { "enum": ["adequate", "missing_concept", "missing_state", "missing_operation"] },
              "description": { "type": "string", "minLength": 1 },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "architecture": {
            "type": "object",
            "required": ["assessment", "description", "evidence"],
            "additionalProperties": false,
            "properties": {
              "assessment": { "enum": ["adequate", "missing_boundary", "missing_invariant", "missing_abstraction", "missing_enforcement"] },
              "description": { "type": "string", "minLength": 1 },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "disposition": {
            "enum": ["fix_instances", "unify_implementation", "architecture_escalation", "explicit_deferral"],
            "description": "Required next action for this family."
          },
          "deferral_reason": {
            "type": "string",
            "minLength": 1,
            "description": "Reason an explicit deferral is safe."
          }
        }
      }
    },
    "reasoning": {
      "type": "string",
      "description": "Private producer scratchpad; not forwarded downstream."
    }
  }
}
