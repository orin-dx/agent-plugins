{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation-run@1",
  "title": "Evaluation Run Evidence",
  "description": "Unadjudicated evidence from one isolated hidden-oracle workflow run.",
  "type": "object",
  "required": ["id", "fixture", "route", "execution", "workspace_state", "artifacts", "commands", "pending_checks", "limitations", "metrics", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "fixture": {"type": "string", "minLength": 1},
    "route": {"type": "string", "minLength": 1},
    "execution": {
      "type": "object",
      "required": ["harness", "mode", "recorded_at", "host_version", "model", "roles", "plugins"],
      "additionalProperties": false,
      "properties": {
        "harness": {"type": "string", "minLength": 1},
        "mode": {"enum": ["single-agent", "team"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "host_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "roles": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "plugins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "version", "source_revision"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "source_revision": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "workspace_state": {
      "type": "object",
      "required": ["revision", "dirty"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "path"],
        "additionalProperties": false,
        "properties": {
          "stage": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "unavailable"]},
          "exit_code": {"type": ["integer", "null"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "pending_checks": {"type": "array", "maxItems": 0},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "metrics": {
      "type": "object",
      "required": ["duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {"type": "number", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "agent_invocations": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0}
      }
    },
    "reasoning": {"type": "string", "description": "Private producer scratchpad; not forwarded downstream."}
  }
}
