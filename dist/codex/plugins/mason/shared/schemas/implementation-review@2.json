{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "implementation-review@2",
  "title": "Implementation Review",
  "description": "Pre-gate implementation review covering verification fit, related defects, and structural signals.",
  "type": "object",
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]},
      "then": {
        "properties": {
          "issues": {"not": {"contains": {"properties": {"severity": {"const": "must_fix"}}, "required": ["severity"]}}},
          "coverage_gaps": {"items": {"properties": {"blocking": {"const": false}}, "required": ["blocking"]}},
          "verification": {
            "properties": {
              "boundary": {"properties": {"status": {"not": {"const": "gap"}}}},
              "input_space": {"properties": {"status": {"not": {"const": "gap"}}}},
              "environment": {"properties": {"status": {"not": {"const": "gap"}}}},
              "external_state": {"properties": {"status": {"not": {"const": "gap"}}}}
            }
          },
          "defect_families": {
            "items": {
              "properties": {
                "instances": {"not": {"contains": {"properties": {"status": {"const": "unresolved"}}, "required": ["status"]}}},
                "disposition": {"not": {"const": "architecture_escalation"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "changes_requested"}}, "required": ["status"]},
      "then": {
        "anyOf": [
          {"properties": {"issues": {"contains": {"properties": {"severity": {"const": "must_fix"}}, "required": ["severity"]}}}, "required": ["issues"]},
          {"properties": {"coverage_gaps": {"contains": {"properties": {"blocking": {"const": true}}, "required": ["blocking"]}}}, "required": ["coverage_gaps"]}
        ]
      }
    },
    {
      "if": {"properties": {"status": {"const": "needs_architecture"}}, "required": ["status"]},
      "then": {"properties": {"defect_families": {"contains": {"properties": {"disposition": {"const": "architecture_escalation"}}, "required": ["disposition"]}}}}
    },
    {
      "if": {"properties": {"defect_families": {"contains": {"properties": {"disposition": {"const": "architecture_escalation"}}, "required": ["disposition"]}}}, "required": ["defect_families"]},
      "then": {"properties": {"status": {"const": "needs_architecture"}}}
    }
  ],
  "required": ["id", "workspace", "batch_id", "languages", "status", "sibling_search", "verification", "issues", "defect_families", "coverage_gaps", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "linked_spec": {"type": "string", "minLength": 1},
    "linked_plan": {"type": "string", "minLength": 1},
    "linked_requirement": {"type": "string", "minLength": 1},
    "spec_file_path": {"type": "string", "minLength": 1},
    "workspace_revision": {"type": ["string", "null"]},
    "status": {"enum": ["approved", "changes_requested", "needs_architecture"]},
    "sibling_search": {
      "type": "object",
      "required": ["scope", "syntactic", "semantic"],
      "additionalProperties": false,
      "properties": {
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "syntactic": {"$ref": "#/$defs/search"},
        "semantic": {
          "type": "object",
          "required": ["method", "evidence", "matches", "basis", "candidate_sites"],
          "additionalProperties": false,
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "matches": {"type": "integer", "minimum": 0},
            "basis": {"type": "string", "minLength": 1, "description": "Domain responsibility or failure state used to derive candidates independently of syntax."},
            "candidate_sites": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["location", "responsibility", "outcome"],
                "additionalProperties": false,
                "properties": {
                  "location": {"type": "string", "minLength": 1},
                  "responsibility": {"type": "string", "minLength": 1},
                  "outcome": {"enum": ["original", "match", "refuted", "unresolved"]}
                }
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["boundary", "input_space", "environment", "external_state"],
      "additionalProperties": false,
      "properties": {
        "boundary": {"$ref": "#/$defs/assessment"},
        "input_space": {
          "type": "object",
          "required": ["status", "rationale", "evidence", "method"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["verified", "gap", "not_applicable"]},
            "rationale": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "method": {"enum": ["examples", "property", "fuzz", "model_based", "mixed", "not_applicable"]},
            "generator": {"type": "string", "minLength": 1},
            "oracle": {"type": "string", "minLength": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"method": {"enum": ["property", "fuzz", "model_based", "mixed"]}}, "required": ["method"]},
              "then": {"required": ["generator", "oracle"]}
            }
          ]
        },
        "environment": {"$ref": "#/$defs/assessment"},
        "external_state": {
          "type": "object",
          "required": ["status", "rationale", "evidence", "sources"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["verified", "gap", "not_applicable"]},
            "rationale": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "identity", "observed_at"],
                "additionalProperties": false,
                "properties": {
                  "source": {"type": "string", "minLength": 1},
                  "identity": {"type": "string", "minLength": 1},
                  "observed_at": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "description", "severity"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1},
          "severity": {"enum": ["must_fix", "suggestion"]},
          "family_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "defect_families": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "if": {"properties": {"disposition": {"const": "explicit_deferral"}}, "required": ["disposition"]},
            "then": {
              "required": ["deferral_reason"],
              "properties": {"instances": {"contains": {"properties": {"status": {"const": "deferred"}}, "required": ["status"]}}}
            },
            "else": {
              "not": {"required": ["deferral_reason"]},
              "properties": {"instances": {"items": {"properties": {"status": {"not": {"const": "deferred"}}}}}}
            }
          }
        ],
        "required": ["id", "summary", "shared_root_cause", "instances", "semantic_model", "architecture", "disposition"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "shared_root_cause": {"type": "string", "minLength": 1},
          "instances": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["file", "line", "relationship", "status", "evidence"],
              "additionalProperties": false,
              "properties": {
                "file": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "relationship": {"enum": ["original", "syntactic_sibling", "semantic_sibling"]},
                "status": {"enum": ["fixed", "unresolved", "deferred"]},
                "evidence": {"type": "string", "minLength": 1}
              }
            }
          },
          "semantic_model": {"$ref": "#/$defs/structuralAssessment"},
          "architecture": {"$ref": "#/$defs/architectureAssessment"},
          "disposition": {"enum": ["fix_instances", "unify_implementation", "architecture_escalation", "explicit_deferral"]},
          "deferral_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "description", "blocking"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["boundary", "input_space", "environment", "external_state", "mutation", "language_pack", "architecture_model", "other"]},
          "description": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "reasoning": {"type": "string", "description": "Private producer scratchpad; not forwarded downstream."}
  },
  "$defs": {
    "search": {
      "type": "object",
      "required": ["method", "evidence", "matches"],
      "additionalProperties": false,
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "matches": {"type": "integer", "minimum": 0}
      }
    },
    "assessment": {
      "type": "object",
      "required": ["status", "rationale", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["verified", "gap", "not_applicable"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "structuralAssessment": {
      "type": "object",
      "required": ["assessment", "description", "evidence"],
      "additionalProperties": false,
      "properties": {
        "assessment": {"enum": ["adequate", "missing_concept", "missing_state", "missing_operation"]},
        "description": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "architectureAssessment": {
      "type": "object",
      "required": ["assessment", "description", "evidence"],
      "additionalProperties": false,
      "properties": {
        "assessment": {"enum": ["adequate", "missing_boundary", "missing_invariant", "missing_abstraction", "missing_enforcement"]},
        "description": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
