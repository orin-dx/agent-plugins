{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-artifact@1",
  "title": "ReleaseArtifact",
  "description": "What was in a release: version, changesets, and breaking changes.",
  "type": "object",
  "required": ["version", "date", "changesets"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Semver version string (e.g. 1.2.0)"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Release date in ISO 8601 format (YYYY-MM-DD)"
    },
    "changesets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["summary", "type"],
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string",
            "description": "One sentence describing what changed, written from the user's perspective"
          },
          "type": {
            "enum": ["feat", "fix", "breaking", "docs", "chore"],
            "description": "Conventional commit type"
          },
          "linked_requirement": {
            "type": "string",
            "description": "ID of the requirement@1 this changeset addresses"
          },
          "pr_url": {
            "type": "string",
            "description": "URL of the merged PR"
          },
          "commits": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Git SHAs included in this changeset"
          }
        }
      }
    },
    "breaking_changes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Human-readable descriptions of all breaking changes in this release"
    },
    "migration_guide": {
      "type": "string",
      "description": "Optional: instructions for upgrading from the previous version"
    },
    "reasoning": {
      "type": "string",
      "description": "Agent scratchpad — not consumed downstream"
    }
  }
}
