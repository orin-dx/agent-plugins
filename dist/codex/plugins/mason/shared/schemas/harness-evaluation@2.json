{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harness-evaluation@2",
  "title": "Harness Evaluation",
  "description": "Evidence-led workflow evaluation with exact harness, plugin, model, and workspace provenance.",
  "type": "object",
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "pass"}}, "required": ["outcome"]},
      "then": {
        "properties": {
          "metrics": {"properties": {"false_passes": {"const": 0}}},
          "blocking_findings": {"maxItems": 0},
          "artifacts": {"items": {"properties": {"schema_valid": {"const": true}, "consumer_usable": {"const": true}}}}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"enum": ["fail", "unverifiable"]}}, "required": ["outcome"]},
      "then": {"properties": {"blocking_findings": {"minItems": 1}}}
    }
  ],
  "required": ["id", "fixture", "route", "execution", "workspace_state", "artifacts", "metrics", "outcome", "blocking_findings", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "fixture": {"type": "string", "minLength": 1},
    "route": {"type": "string", "minLength": 1},
    "execution": {
      "type": "object",
      "required": ["harness", "mode", "recorded_at", "host_version", "model", "roles", "plugins"],
      "additionalProperties": false,
      "properties": {
        "harness": {"type": "string", "minLength": 1},
        "mode": {"enum": ["single-agent", "team"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "host_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "roles": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "plugins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "version", "source_revision"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "source_revision": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "workspace_state": {
      "type": "object",
      "required": ["revision", "dirty"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "schema", "path", "schema_valid", "evidence_paths", "consumer_usable", "notes"],
        "additionalProperties": false,
        "properties": {
          "stage": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "schema_valid": {"type": "boolean"},
          "evidence_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "consumer_usable": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["seeded_defects", "detected_defects", "false_passes", "human_corrections", "duration_seconds"],
      "additionalProperties": false,
      "properties": {
        "seeded_defects": {"type": "integer", "minimum": 0},
        "detected_defects": {"type": "integer", "minimum": 0},
        "false_passes": {"type": "integer", "minimum": 0},
        "human_corrections": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "agent_invocations": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0}
      }
    },
    "outcome": {"enum": ["pass", "fail", "unverifiable"]},
    "blocking_findings": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reasoning": {"type": "string"}
  }
}
