{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspace-manifest@1",
  "title": "Workspace Manifest",
  "description": "Verified workspace state and available verification capabilities discovered before implementation or audit work begins.",
  "type": "object",
  "required": ["workspace_root", "workspace_state", "languages", "language_files", "entry_points", "live_files", "capabilities", "baseline", "confidence", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "workspace_root": {"type": "string", "minLength": 1},
    "workspace_state": {
      "type": "object",
      "required": ["revision", "dirty"],
      "additionalProperties": false,
      "properties": {
        "revision": {"type": ["string", "null"], "description": "Current commit or equivalent immutable state identifier when available."},
        "dirty": {"type": "boolean"},
        "evidence": {"type": "string"}
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Every language affected by the requested scope; values are open for future ecosystems."
    },
    "language_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["language", "files"],
        "additionalProperties": false,
        "properties": {
          "language": {"type": "string", "minLength": 1},
          "files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      },
      "description": "Maps each affected language to its scoped live files for polyglot consumers."
    },
    "entry_points": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "live_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dead_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "available", "source"],
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["build", "test", "type_check", "lint", "mutation", "property", "fuzz", "race", "integration", "boundary"]},
          "available": {"type": "boolean"},
          "tool": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1, "description": "Workspace file or observed command that established availability."}
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pass", "fail", "not_run"]},
        "command": {"type": "string", "minLength": 1},
        "evidence": {"type": "string"}
      }
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "spec_file_path": {"type": ["string", "null"]},
    "plan_file_path": {"type": ["string", "null"]},
    "spec_drift_warning": {"type": ["string", "null"]},
    "plan_drift_warning": {"type": ["string", "null"]},
    "workflow_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["plugin", "version"],
        "additionalProperties": false,
        "properties": {
          "plugin": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "minLength": 1}
        }
      }
    },
    "reasoning": {"type": "string", "description": "Private producer scratchpad; not forwarded downstream."}
  }
}
