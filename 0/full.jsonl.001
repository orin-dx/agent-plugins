).is_file():\\n-                    broken.append(f\\\"{source.relative_to(REPOSITORY_ROOT)} -> {reference}\\\")\\n+                    broken.append(f\\\"{source_name} -> {reference}\\\")\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a08c77-4ac1-77a0-808c-4dde87d268d4","create_time":1789064436.246809}}}
