{"timestamp":"2026-09-10T02:40:50.232Z","ordinal":7164,"type":"event_msg","payload":{"type":"token_count","info":{"total_token_usage":{"input_tokens":105305251,"cached_input_tokens":103134208,"cache_write_input_tokens":0,"output_tokens":457399,"reasoning_output_tokens":157779,"total_tokens":105762650},"last_token_usage":{"input_tokens":190047,"cached_input_tokens":188800,"cache_write_input_tokens":0,"output_tokens":2688,"reasoning_output_tokens":286,"total_tokens":192735},"model_context_window":258400},"rate_limits":{"limit_id":"codex","limit_name":null,"primary":{"used_percent":57.0,"window_minutes":10080,"resets_at":1789436456},"secondary":null,"credits":{"has_credits":false,"unlimited":false,"balance":"0"},"individual_limit":null,"spend_control_reached":null,"plan_type":"prolite","rate_limit_reached_type":null}}}
