n   1 shared/references/implementation-review.md:shared/references/python-hazards.md\n   1 shared/references/implementation-review.md:shared/references/python-hazards-t7-t10.md\n   1 shared/references/implementation-review.md:shared/references/go-smells.md\n   1 shared/references/implementation-review.md:shared/references/go-hazards.md\n   1 shared/references/implementation-review.md:shared/references/go-hazards-t7-t10.md\n   1 shared/references/implementation-review.md:shared/references/code-comments.md\n   1 shared/references/conventional-commits.md:shared/references/docs-voice.md\n   1 shared/references/changesets.md:shared/references/docs-voice.md\n   1 shared/references/architecture-remediation.md:shared/references/workspace-conventions.md\n   1 shared/references/architecture-remediation.md:shared/references/typescript-smells.md\n   1 shared/references/architecture-remediation.md:shared/references/rust-smells.md\n   1 shared/references/architecture-remediation.md:shared/references/python-smells.md\n   1 shared/references/architecture-remediation.md:shared/references/go-smells.md\n   1 shared/agent-best-practices.md:shared/references/rust-hazards.md\n   1 plugins/weaver/agents/auditor.md:shared/references/workspace-conventions.md\n   1 plugins/weaver/CHANGELOG.md:shared/references/workspace-conventions.md\n   1 plugins/vanguard/agents/recon.md:shared/references/workspace-conventions.md\n   1 plugins/vanguard/CHANGELOG.md:shared/references/workspace-conventions.md\n   1 plugins/vanguard/CHANGELOG.md:shared/references/orin-visual-standard.md\n   1 plugins/smith/skills/implement/SKILL.md:shared/references/verification-evidence.md\n   1 plugins/smith/agents/reviewer.md:shared/references/implementation-review.md\n   1 plugins/smith/agents/mutator.md:shared/references/typescript-tooling.md\n   1 plugins/smith/agents/mutator.md:shared/references/rust-tooling.md\n   1 plugins/smith/agents/mutator.md:shared/references/python-tooling.md\n   1 plugins/smith/agents/mutator.