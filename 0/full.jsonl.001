dist/codex/plugins/ranger/shared/references/go-hazards-t7-t10.md\\n D dist/codex/plugins/ranger/shared/references/go-hazards.md\\n D dist/codex/plugins/ranger/shared/references/python-hazards-t7-t10.md\\n D dist/codex/plugins/ranger/shared/references/python-hazards.md\\n D dist/codex/plugins/ranger/shared/references/rust-hazards-t7-t10.md\\n D dist/codex/plugins/ranger/shared/references/rust-hazards.md\\n D dist/codex/plugins/ranger/shared/references/typescript-hazards-t7-t10.md\\n D dist/codex/plugins/ranger/shared/references/typescript-hazards.md\\n M dist/codex/plugins/ranger/skills/audit/SKILL.md\\n M dist/codex/plugins/scribe/.codex-plugin/plugin.json\\n D dist/codex/plugins/scribe/shared/references/architecture-remediation.md\\n D dist/codex/plugins/scribe/shared/references/go-smells.md\\n D dist/codex/plugins/scribe/shared/references/python-smells.md\\n D dist/codex/plugins/scribe/shared/references/rust-smells.md\\n D dist/codex/plugins/scribe/shared/references/typescript-smells.md\\n D dist/codex/plugins/scribe/shared/references/workspace-conventions.md\\n M dist/codex/plugins/scribe/skills/architect/SKILL.md\\n M dist/codex/plugins/sentinel/.codex-plugin/plugin.json\\n M dist/codex/plugins/smith/.codex-plugin/plugin.json\\n D dist/codex/plugins/smith/shared/references/code-comments.md\\n D dist/codex/plugins/smith/shared/references/go-hazards-t7-t10.md\\n D dist/codex/plugins/smith/shared/references/go-hazards.md\\n D dist/codex/plugins/smith/shared/references/go-smells.md\\n D dist/codex/plugins/smith/shared/references/go-tooling.md\\n D dist/codex/plugins/smith/shared/references/implementation-review.md\\n D dist/codex/plugins/smith/shared/references/python-hazards-t7-t10.md\\n D dist/codex/plugins/smith/shared/references/python-hazards.md\\n D dist/codex/plugins/smith/shared/references/python-smells.md\\n D dist/codex/plugins/smith/shared/references/python-tooling.md\\n D dist/codex/plugins/smith/shared/references/rust-hazards-t7-t10.md\\n D dist/codex/p