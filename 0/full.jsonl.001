on/skills/evaluate/SKILL.md:7:version: 1.0.0\n./shared/references/changesets.md:71:## v2.0.0 (2026-08-04)\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a088c6-48bb-7040-a264-83f7cdb1775a","create_time":1789008902.27429}}}
