rds/rust.md\",\n        \"shared/references/hazards/rust-boundaries.md\",\n        \"shared/references/architecture/rust.md\",\n        \"shared/references/verification/rust.md\",\n        \"shared/references/hazards/typescript.md\",\n        \"shared/references/hazards/typescript-boundaries.md\",\n        \"shared/references/architecture/typescript.md\",\n        \"shared/references/verification/typescript.md\",\n        \"shared/references/verification/evidence.md\"\n      ]\n    },\n    {\n      \"id\": \"vanguard\",\n      \"runtime_files\": [\n        \"shared/schemas/requirement@1.json\",\n        \"shared/schemas/research-report@1.json\"\n      ]\n    },\n    {\n      \"id\": \"weaver\",\n      \"runtime_files\": [\n        \"shared/schemas/plan@1.json\",\n        \"shared/schemas/requirement@1.json\",\n        \"shared/schemas/spec@1.json\"\n      ]\n    }\n  ]\n}\n{\n  \"id\": \"mason\",\n  \"name\": \"mason\",\n  \"version\": \"3.2.2\",\n  \"description\": \"Build, audit, and behaviorally evaluate plugins; design shared schemas and scaffold conformant agents. Skills: scaffold-plugin, audit-plugin, design-schema, scaffold-subagent, evaluate.\",\n  \"author\": {\n    \"name\": \"Gabriel Castro\",\n    \"email\": \"gabe@techworx.dev\"\n  },\n  \"skills\": \"./skills/\",\n  \"agents\": [\n    \"./agents/auditor.md\",\n    \"./agents/evaluation-adjudicator.md\",\n    \"./agents/evaluation-runner.md\",\n    \"./agents/scaffolder.md\",\n    \"./agents/schema-designer.md\"\n  ],\n  \"consumes\": [],\n  \"produces\": [\n    \"evaluation-run@1\",\n    \"harness-evaluation@2\"\n  ]\n}\n{\n  \"id\": \"ranger\",\n  \"name\": \"ranger\",\n  \"version\": \"3.2.2\",\n  \"description\": \"Bug hunting for Rust, TypeScript, JavaScript, Python, and Go. Confirms reachable defects, searches semantic siblings, and routes structural families for architectural correction.\",\n  \"author\": {\n    \"name\": \"Gabriel Castro\",\n    \"email\": \"gabe@techworx.dev\"\n  },\n  \"skills\": \"./skills/\",\n  \"agents\": [\n    \"./agents/adversary.md\",\n    \"./agents/boundary-tracer.md\",\n    \"./agents/exit-gate.md\",\n    \"./agents/recon.md\",\n    \"./agents/scanner.md\"\n  ],\n  \"consumes\": [],\n  \"produces\": [\n    \"workspace-manifest@1\",\n    \"candidate-assessment@1\",\n    \"finding-report@2\",\n    \"verdict@3\"\n  ]\n}\n{\n  \"id\": \"weaver\",\n  \"name\": \"weaver\",\n  \"version\": \"3.0.3\",\n  \"description\": \"Need definition plugin. Captures and structures requirements before implementation begins. Integrates with GitHub Issues by default; extensible to any issue tracker that produces the requirement@1 schema. Skills: capture-need, clarify-requirement, prioritize-backlog, connect-requirement, audit-backlog.\",\n  \"author\": {\n    \"name\": \"Gabriel Castro\",\n    \"email\": \"gabe@techworx.dev\"\n  },\n  \"skills\": \"./skills/\",\n  \"agents\": [\n    \"./agents/auditor.md\",\n    \"./agents/clarifier.md\",\n    \"./agents/intake.md\",\n    \"./agents/prioritizer.md\"\n  ],\n  \"consumes\": [],\n  \"produces\": [\n    \"requirement@1\"\n  ]\n}\n{\n  \"id\": \"vanguard\",\n  \"name\": \"vanguard\",\n  \"version\": \"2.0.2\",\n  \"description\": \"Research plugin. Investigates questions and requirements to build a documented evidence base before committing to a solution direction. Distinguishes confirmed findings from assumptions. Produces research-report@1 for consumption by scribe (spec).\",\n  \"author\": {\n    \"name\": \"Gabriel Castro\",\n    \"email\": \"gabe@techworx.dev\"\n  },\n  \"skills\": \"./skills/\",\n  \"agents\": [\n    \"./agents/reader.md\",\n    \"./agents/recon.md\",\n    \"./agents/risk-assessor.md\",\n    \"./agents/synthesizer.md\"\n  ],\n  \"consumes\": [\n    \"requirement@1\"\n  ],\n  \"produces\": [\n    \"research-report@1\"\n  ]\n}\n{\n  \"id\": \"scribe\",\n  \"name\": \"scribe\",\n  \"version\": \"3.3.2\",\n  \"description\": \"Specification plugin. Drafts and gates testable specs, checks whole-system architecture, detects drift, and turns Ranger findings or Smith implementation reviews into structural corrections. Skills: draft-spec, verify-spec, spec-drift, audit-spec, audit-architecture, gate-spec, correct-spec, architect.\",\n  \"author\": {\n    \"name\": \"Gabriel Castro\",\n    \"email\": \"gabe@techworx.dev\"\n  },\n  \"skills\": \"./skills/\",\n  \"agents\": [\n    \"./agents/architect.md\",\n    \"./agents/arch-auditor.md\",\n    \"./agents/auditor.md\",\n    \"./agents/drift-checker.md\",\n    \"./agents/drafter.md\",\n    \"./agents/exit-gate.md\",\n    \"./agents/verifier.md\"\n  ],\n  \"consumes\": [\n    \"requirement@1\",\n    \"research-report@1\",\n    \"finding-report@2\",\n    \"implementation-review@2\",\n    \"implementation-result@1\"\n  ],\n  \"produces\": [\n    \"spec@1\",\n    \"verdict@3\",\n    \"arch-audit@1\",\n    \"arch-model@1\"\n  ]\n}\n{\n  \"id\": \"navigator\",\n  \"name\": \"navigator\",\n  \"version\": \"2.3.2\",\n  \"description\": \"Planning plugin. Decomposes specs into sequenced, bite-sized implementation plans with an implementation approach, exact code as a baseline, and the tests proving each criterion — no write-test-first mandate. Tasks are sized to compilation boundaries, not a clock-time estimate. No TBDs. A developer with zero domain context can execute the plan mechanically.\",\n  \"author\": {\n    \"name\": \"Gabriel Castro\",\n    \"email\": \"gabe@techworx.dev\"\n  },\n  \"skills\": \"./skills/\",\n  \"agents\": [\n    \"./agents/challenger.md\",\n    \"./agents/estimator.md\",\n    \"./agents/planner.md\"\n  ],\n  \"consumes\": [\n    \"spec@1\"\n  ],\n  \"produces\": [\n    \"plan@1\"\n  ]\n}\n{\n  \"id\": \"smith\",\n  \"name\": \"smith\",\n  \"version\": \"2.4.2\",\n  \"description\": \"Implementation plugin. Executes tested plan batches, verifies risk at real boundaries, searches semantic defect siblings, and escalates shared model or architecture gaps.\",\n  \"author\": {\n    \"name\": \"Gabriel Castro\",\n    \"email\": \"gabe@techworx.dev\"\n  },\n  \"skills\": \"./skills/\",\n  \"agents\": [\n    \"./agents/exit-gate.md\",\n    \"./agents/implementer.md\",\n    \"./agents/mutator.md\",\n    \"./agents/recon.md\",\n    \"./agents/reviewer.md\"\n  ],\n  \"consumes\": [\n    \"plan@1\",\n    \"spec@1\"\n  ],\n  \"produces\": [\n    \"workspace-manifest@1\",\n    \"implementation-result@1\",\n    \"mutation-report@2\",\n    \"implementation-review@2\",\n    \"verdict@3\"\n  ]\n}\n{\n  \"id\": \"courier\",\n  \"name\": \"courier\",\n  \"version\": \"3.0.3\",\n  \"description\": \"Shipping plugin. Shepherds completed, verified code through commit, PR creation, review response, and changeset documentation. Skills: commit, pr, changeset, receive-feedback, post-review, release. Produces release-artifact@2 from changeset@2 inputs.\",\n  \"author\": {\n    \"name\": \"Gabriel Castro\",\n    \"email\": \"gabe@techworx.dev\"\n  },\n  \"skills\": \"./skills/\",\n  \"agents\": [\n    \"./agents/changeset-analyzer.md\",\n    \"./agents/commit-analyzer.md\",\n    \"./agents/pr-narrator.md\",\n    \"./agents/release-summarizer.md\",\n    \"./agents/review-preprocessor.md\"\n  ],\n  \"consumes\": [],\n  \"produces\": [\n    \"changeset@2\",\n    \"release-artifact@2\"\n  ]\n}\n\n","exit_code":0,"duration":{"secs":0,"nanos":584},"formatted_output":"{\n  \"$schema\": \"https://antigravity.google/schemas/marketplace.json\",\n  \"name\": \"wisp-plugins\",\n  \"version\": \"4.4.2\",\n  \"description\": \"Wisp Plugins marketplace for AGY and Claude Code, published by Orin DX\",\n  \"plugins\": [\n    {\n      \"id\": \"mason\",\n      \"name\": \"mason\",\n      \"version\": \"3.2.2\",\n      \"path\": \"./plugins/mason\",\n      \"description\": \"Build, audit, and behaviorally evaluate plugins; design shared schemas and scaffold conformant agents. Skills: scaffold-plugin, audit-plugin, design-schema, scaffold-subagent, evaluate.\",\n      \"supersedes\": \"agent-plugin-builder\"\n    },\n    {\n      \"id\": \"ranger\",\n      \"name\": \"ranger\",\n      \"version\": \"3.2.2\",\n      \"path\": \"./plugins/ranger\",\n      \"description\": \"Bug hunting for Rust, TypeScript, JavaScript, Python, and Go. Confirms reachable defects, searches semantic siblings, and routes structural families for architectural correction.\",\n      \"supersedes\": [\n        \"bug-hunter-rust\",\n        \"bug-hunter-ts\"\n      ]\n    },\n    {\n      \"id\": \"sentinel\",\n      \"name\": \"sentinel\",\n      \"version\": \"2.1.1\",\n      \"path\": \"./plugins/sentinel\",\n      \"description\": \"Cross-cutting verification gate. Confirms that any stage artifact meets its criteria before the next stage begins. One skill, one recon-verify-judge pipeline, reused unchanged against any artifact type.\",\n      \"supersedes\": \"verify-first\"\n    },\n    {\n      \"id\": \"weaver\",\n      \"name\": \"weaver\",\n      \"version\": \"3.0.3\",\n      \"path\": \"./plugins/weaver\",\n      \"description\": \"Need definition plugin. Captures and structures requirements before implementation begins. Integrates with GitHub Issues by default; extensible to Linear, Jira, or any issue tracker that produces the requirement@1 schema. Skills: capture-need, clarify-requirement, prioritize-backlog, connect-requirement, audit-backlog.\"\n    },\n    {\n      \"id\": \"vanguard\",\n      \"name\": \"vanguard\",\n      \"version\": \"2.0.2\",\n      \"path\": \"./plugins/vanguard\",\n      \"description\": \"Research plugin. Investigates questions and requirements to build a documented evidence base before committing to a solution direction. Produces research-report@1 for consumption by scribe (spec).\"\n    },\n    {\n      \"id\": \"scribe\",\n      \"name\": \"scribe\",\n      \"version\": \"3.3.2\",\n      \"path\": \"./plugins/scribe\",\n      \"description\": \"Specification plugin. Turns requirements and research reports into unambiguous, testable specs. Checks specs against a persisted whole-system architecture model. Detects spec drift against actual code. Skills: draft-spec, verify-spec, spec-drift, audit-spec, audit-architecture, gate-spec, correct-spec, architect.\"\n    },\n    {\n      \"id\": \"muse\",\n      \"name\": \"muse\",\n      \"version\": \"1.0.1\",\n      \"path\": \"./plugins/muse\",\n      \"description\": \"Component specification plugin. Turns UI/design intent into unambiguous, testable component specs — props, variants, per-state behavior, and accessibility criteria as testable propositions, gated before planning. Audits the spec, not the implementation — see ranger's accessibility hazard taxonomy for code-level scanning.\"\n    },\n    {\n      \"id\": \"navigator\",\n      \"name\": \"navigator\",\n      \"version\": \"2.3.2\",\n      \"path\": \"./plugins/navigator\",\n      \"description\": \"Planning plugin. Decomposes specs into sequenced, bite-sized implementation plans with an implementation approach, exact code as a baseline, and the tests proving each criterion — no write-test-first mandate. Tasks are sized to compilation boundaries, not a clock-time estimate. No TBDs. A developer with zero domain context can execute the plan mechanically.\"\n    },\n    {\n      \"id\": \"smith\",\n      \"name\": \"smith\",\n      \"version\": \"2.4.2\",\n      \"path\": \"./plugins/smith\",\n      \"description\": \"Implementation plugin. Executes tested plan batches, verifies risk at real boundaries, searches semantic defect siblings, and escalates shared model or architecture gaps.\"\n    },\n    {\n      \"id\": \"courier\",\n      \"name\": \"courier\",\n      \"version\": \"3.0.3\",\n      \"path\": \"./plugins/courier\",\n      \"description\": \"Shipping plugin. Shepherds completed code through commit, PR creation, review response, and changeset documentation. Skills: commit, pr, changeset, receive-feedback, post-review, release.\"\n    }\n  ]\n}\n{\n  \"catalog_version\": 1,\n  \"harness\