md\n35\t59\tshared/references/modern-cli-tools.md\n2\t0\tshared/references/python-hazards-t7-t10.md\n2\t0\tshared/references/python-hazards.md\n2\t0\tshared/references/python-smells.md\n25\t58\tshared/references/rust-hazards-t7-t10.md\n52\t80\tshared/references/rust-hazards.md\n22\t88\tshared/references/rust-smells.md\n23\t35\tshared/references/rust-tooling.md\n1\t1\tshared/references/rust.md\n25\t59\tshared/references/typescript-hazards-t7-t10.md\n59\t94\tshared/references/typescript-hazards.md\n23\t61\tshared/references/typescript-smells.md\n23\t28\tshared/references/typescript-tooling.md\n1\t1\tshared/references/typescript.md\n13\t17\tshared/references/workspace-conventions.md\n","exit_code":0,"duration":{"secs":0,"nanos":49086792},"formatted_output":"2\t0\tshared/references/go-hazards-t7-t10.md\n2\t0\tshared/references/go-hazards.md\n2\t0\tshared/references/go-smells.md\n24\t22\tshared/references/interface-implementers.md\n0\t92\tshared/references/mcp-protocol.md\n35\t59\tshared/references/modern-cli-tools.md\n2\t0\tshared/references/python-hazards-t7-t10.md\n2\t0\tshared/references/python-hazards.md\n2\t0\tshared/references/python-smells.md\n25\t58\tshared/references/rust-hazards-t7-t10.md\n52\t80\tshared/references/rust-hazards.md\n22\t88\tshared/references/rust-smells.md\n23\t35\tshared/references/rust-tooling.md\n1\t1\tshared/references/rust.md\n25\t59\tshared/references/typescript-hazards-t7-t10.md\n59\t94\tshared/references/typescript-hazards.md\n23\t61\tshared/references/typescript-smells.md\n23\t28\tshared/references/typescript-tooling.md\n1\t1\tshared/references/typescript.md\n13\t17\tshared/references/workspace-conventions.md\n"},"started_at_ms":1789009292693,"completed_at_ms":1789009292743}}
